{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "action"
      ]
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "processing",
        "completed",
        "failed",
        "reversed"
      ],
      "description": "Optional workflow state for notifications that represent actionable requests or transaction events."
    }
  },
  "required": [
    "user_id",
    "title",
    "message"
  ]
}
