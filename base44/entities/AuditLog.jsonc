{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "The account affected by this action"
    },
    "user_id": {
      "type": "string",
      "description": "The admin who performed the action"
    },
    "admin_name": {
      "type": "string",
      "description": "Display name of the admin"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "transaction_created",
        "transaction_edited",
        "balance_adjusted",
        "withdrawal_processed",
        "withdrawal_rejected",
        "account_created",
        "account_status_changed",
        "application_approved",
        "application_rejected",
        "kyc_approved",
        "kyc_rejected",
        "super_admin_exception_auth",
        "transaction_approved",
        "transaction_declined",
        "investment_deposit_processed",
        "investment_withdrawal_processed",
        "investment_request_rejected"
      ],
      "description": "The type of administrative action performed"
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary of what happened"
    },
    "details": {
      "type": "string",
      "description": "Additional context — notes, references, prior values. For exception auth events: JSON with action, target, result, execution_result. NEVER includes the credential/secret."
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount if applicable (negative for debits)"
    },
    "balance_before": {
      "type": "number",
      "description": "Account balance before the action"
    },
    "balance_after": {
      "type": "number",
      "description": "Account balance after the action"
    },
    "target_user_id": {
      "type": "string",
      "description": "The member affected (for application/KYC actions)"
    }
  },
  "required": [
    "action_type",
    "description"
  ]
}
